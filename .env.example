# MotoChat 环境变量配置（示例）
#
# 用法：复制本文件为 .env，填入真实值。.env 不会被 git 跟踪。
# 环境变量优先级高于 config.json，设置后 config.json 里的对应字段会被覆盖。
# 已经在系统环境变量里设过的值不会被 .env 覆盖。
#
# 全部留空也能跑：程序会退回到 config/config.json（首次启动自动生成），
# 也可以直接在管理端界面的「系统设置」里改，无需手写 .env。

# ===== LLM（必填）=====
# 任何 OpenAI 兼容接口都行：官方 OpenAI、DeepSeek、通义、本地 Ollama / vLLM 等
MOTOCHAT_LLM_API_KEY=
MOTOCHAT_LLM_BASE_URL=https://api.openai.com/v1
MOTOCHAT_LLM_MODEL=gpt-4o-mini
# 本地 Ollama 示例：BASE_URL=http://localhost:11434/v1，MODEL=qwen2.5:7b

# ===== Vision（图片识别，留空则回退到 LLM 的 key）=====
MOTOCHAT_VISION_API_KEY=
MOTOCHAT_VISION_BASE_URL=https://api.openai.com/v1
MOTOCHAT_VISION_MODEL=gpt-4o-mini

# ===== TTS（语音合成，留空则禁用该功能）=====
MOTOCHAT_TTS_API_KEY=
MOTOCHAT_TTS_MODEL_ID=

# ===== Web 服务 =====
MOTOCHAT_HOST=127.0.0.1
MOTOCHAT_PORT=7860
MOTOCHAT_SECRET=
